# Canlı site adresi (build öncesi doğru adresi yazın)
# Canlı domain: https://mamon.com.tr
# IP test:     http://50.114.185.221:3001
NEXT_PUBLIC_SITE_URL=https://mamon.com.tr
NEXT_PUBLIC_SITE_NAME=Mamon

# Admin panel şifresi — üretimde mutlaka güçlü bir değer kullanın
ADMIN_PASSWORD=guclu-bir-sifre-belirleyin

# Opsiyonel: uygulama portu (varsayılan 3001)
PORT=3001

# MySQL (cPanel / sunucu — şimdilik site JSON dosyası kullanıyor, ileride CMS için)
DB_HOST=localhost
DB_NAME=veritabani_adi
DB_USER=veritabani_kullanici
DB_PASSWORD=veritabani_sifresi
